# =============================================================================
# Fideliza Corretor — Variáveis de ambiente (exemplo)
# Copie este arquivo para .env e preencha com seus valores reais.
# NUNCA versione o arquivo .env com segredos.
# =============================================================================

# -----------------------------------------------------------------------------
# Aplicação
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
# UUID do tenant usado em desenvolvimento (seed demo do schema).
TENANT_DEMO_ID=00000000-0000-0000-0000-000000000000

# -----------------------------------------------------------------------------
# Banco de dados (Supabase / PostgreSQL)
# -----------------------------------------------------------------------------
# String de conexão completa (connection pooling do Supabase recomendado).
DATABASE_URL=postgresql://postgres:senha@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# Credenciais do projeto Supabase.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=coloque_sua_anon_key_aqui
# ATENÇÃO: chave de serviço tem acesso total — mantenha em segredo, só no backend.
SUPABASE_SERVICE_ROLE_KEY=coloque_sua_service_role_key_aqui

# -----------------------------------------------------------------------------
# IA / RAG (OpenAI ou provedor de embeddings)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=coloque_sua_openai_key_aqui
EMBEDDING_MODEL=text-embedding-3-small

# -----------------------------------------------------------------------------
# WhatsApp / mensageria (opcional)
# -----------------------------------------------------------------------------
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

# -----------------------------------------------------------------------------
# Segurança
# -----------------------------------------------------------------------------
# Segredo para assinatura de tokens JWT da aplicação.
JWT_SECRET=troque_por_um_segredo_forte_e_aleatorio
