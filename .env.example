# =============================================================================
# Fideliza Corretor - Variáveis de Ambiente
# =============================================================================
# Copie para .env e preencha. NUNCA commite .env no git.
#
# Este arquivo (.env.example) serve apenas como referência dos nomes das
# variáveis. Preencha os valores reais somente no seu .env local, que deve
# estar listado no .gitignore.
# =============================================================================


# -----------------------------------------------------------------------------
# Servidor
# -----------------------------------------------------------------------------
# Ambiente de execução: development | production | test
NODE_ENV=development

# Porta em que a API vai escutar
PORT=3000

# URL base pública da aplicação (usada em links de e-mail, callbacks, etc.)
APP_URL=http://localhost:3000

# Segredo para assinar/verificar tokens JWT de sessão (use uma string longa e aleatória)
JWT_SECRET=troque-por-uma-string-secreta-longa-e-aleatoria

# Origens permitidas para CORS (separe múltiplas por vírgula)
CORS_ORIGIN=http://localhost:3000


# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
# URL do projeto Supabase (encontrada em Project Settings > API)
SUPABASE_URL=https://seu-projeto.supabase.co

# Chave pública (anon). Segura para uso no cliente, respeita as políticas de RLS.
SUPABASE_ANON_KEY=sua-chave-anon-publica-aqui

# ATENÇÃO: A service role key IGNORA (bypassa) todas as políticas de RLS e
# concede acesso administrativo total ao banco. Use APENAS no backend, NUNCA
# exponha no frontend nem commite em repositório.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-secreta-aqui


# -----------------------------------------------------------------------------
# Resend (envio de e-mails transacionais)
# -----------------------------------------------------------------------------
# Chave de API do Resend (Dashboard > API Keys)
RESEND_API_KEY=re_sua_chave_do_resend_aqui

# Remetente padrão dos e-mails (deve ser um domínio verificado no Resend)
RESEND_FROM_EMAIL=nao-responder@seudominio.com.br

# Nome exibido como remetente
RESEND_FROM_NAME=Fideliza Corretor


# -----------------------------------------------------------------------------
# WhatsApp (Meta Cloud API - integração direta)
# -----------------------------------------------------------------------------
# URL base da Cloud API da Meta (inclua a versão da Graph API)
WHATSAPP_API_URL=https://graph.facebook.com/v20.0

# ID do número de telefone cadastrado (WhatsApp Manager > Números)
WHATSAPP_PHONE_NUMBER_ID=seu-phone-number-id-aqui

# Token de acesso permanente do app da Meta (System User Access Token)
WHATSAPP_ACCESS_TOKEN=seu-access-token-permanente-aqui

# Token de verificação do webhook (string que você define ao configurar o webhook)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=defina-um-token-de-verificacao-aqui


# -----------------------------------------------------------------------------
# Stripe (pagamentos) - FASE FUTURA
# -----------------------------------------------------------------------------
# STRIPE_SECRET_KEY=sk_test_sua_chave_secreta_do_stripe
# STRIPE_WEBHOOK_SECRET=whsec_seu_segredo_do_webhook
# STRIPE_PUBLISHABLE_KEY=pk_test_sua_chave_publicavel


