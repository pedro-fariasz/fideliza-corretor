# =============================================================================
# Fideliza Corretor — Frontend — Variáveis de Ambiente
# Copie este arquivo para .env e preencha com os valores reais.
# NUNCA commite o .env (já está no .gitignore da raiz do projeto).
# =============================================================================

# URL do projeto Supabase (Project Settings > API)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave publishable/anon do Supabase — usada SOMENTE para login (Supabase Auth).
# ATENÇÃO: a service role key NUNCA pode aparecer no frontend. Se você está
# prestes a colar uma chave que começa com acesso administrativo total, PARE.
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica-aqui

# URL da API backend (Railway em produção; em desenvolvimento local use a porta do backend)
VITE_API_URL=http://localhost:3000
